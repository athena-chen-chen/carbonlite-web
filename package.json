{
  "name": "carbonlite-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode local",
    "dev:pilot": "vite --mode pilot",
    "build": "vite build",
    "build:pilot": "vite build --mode pilot",
    "build:production": "vite build --mode production",
    "lint": "vite build",
    "preview": "vite preview",
    "test": "node --test scripts/dev-database.test.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:e2e": "playwright test --config apps/web-e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config apps/web-e2e/playwright.config.ts --ui",
    "test:e2e:real": "E2E_REAL_API=true playwright test --config apps/web-e2e/playwright.config.ts apps/web-e2e/tests/real-api",
    "test:e2e:real:ui": "E2E_REAL_API=true playwright test --config apps/web-e2e/playwright.config.ts apps/web-e2e/tests/real-api --ui",
    "test:smoke": "playwright test --config apps/web-e2e/playwright.config.ts apps/web-e2e/tests/pilot-demo-smoke.spec.ts",
    "test:prod-smoke": "PLAYWRIGHT_BASE_URL=https://www.carbonliteapp.ca playwright test --config apps/web-e2e/playwright.config.ts apps/web-e2e/tests/production-pilot-reviewer-smoke.spec.ts",
    "verify:pilot": "pnpm build:pilot && pnpm test:smoke",
    "test:regression": "playwright test --config apps/web-e2e/playwright.config.ts --grep @smoke",
    "verify:deployment": "pnpm test && pnpm build && pnpm test:regression",
    "e2e:db:guard": "node scripts/e2e/guard-test-db.mjs",
    "e2e:migrate": "node scripts/e2e/migrate-test-db.mjs",
    "e2e:reset": "node scripts/e2e/reset-test-db.mjs",
    "e2e:seed": "node scripts/e2e/seed-test-db.mjs",
    "seed:task7-fixtures": "node scripts/e2e/seed-task7-factor-fixtures.mjs",
    "create:pilot-reviewer": "node scripts/create-pilot-reviewer.mjs",
    "upgrade:pilot-to-customer": "node scripts/upgrade-pilot-to-customer.mjs",
    "seed:sample-workspace": "pnpm --dir ../carbonlite-api seed:sample-workspace",
    "dev:neon": "node scripts/dev-database.mjs neon",
    "dev:localdb": "node scripts/dev-database.mjs localdb",
    "db:check:neon": "node scripts/dev-database.mjs neon check",
    "db:check:localdb": "node scripts/dev-database.mjs localdb check",
    "db:migrate:neon": "node scripts/dev-database.mjs neon migrate",
    "db:migrate:localdb": "node scripts/dev-database.mjs localdb migrate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@sentry/react": "^10.56.0",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "posthog-js": "^1.383.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.63.0",
    "react-router-dom": "6.29.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.19.9",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.6"
  }
}
