{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupEvidence",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::__BACKUP_BUCKET__",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "pairs/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadBackupManifestAndCiphertextMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold"
      ],
      "Resource": "arn:aws:s3:::__BACKUP_BUCKET__/pairs/*"
    },
    {
      "Sid": "ListControlEvidence",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::__CONTROL_BUCKET__",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "events/*",
            "recovery/*",
            "checkpoints/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadControlEvidence",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold"
      ],
      "Resource": [
        "arn:aws:s3:::__CONTROL_BUCKET__/events/*",
        "arn:aws:s3:::__CONTROL_BUCKET__/recovery/*",
        "arn:aws:s3:::__CONTROL_BUCKET__/checkpoints/*"
      ]
    },
    {
      "Sid": "AppendIndependentApprovalAndGenerationCheckpoint",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::__CONTROL_BUCKET__/recovery/approvals/*",
        "arn:aws:s3:::__CONTROL_BUCKET__/checkpoints/generation/*",
        "arn:aws:s3:::__CONTROL_BUCKET__/events/reviewer/*"
      ]
    },
    {
      "Sid": "SignAndVerifyRecoveryState",
      "Effect": "Allow",
      "Action": [
        "kms:GetPublicKey",
        "kms:Sign",
        "kms:Verify"
      ],
      "Resource": "arn:aws:kms:__REGION__:__BACKUP_ACCOUNT_ID__:key/__SIGNING_KEY_ID__"
    }
  ]
}
