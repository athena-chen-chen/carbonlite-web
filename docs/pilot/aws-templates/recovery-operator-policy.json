{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListApprovedRecoveryPairPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::__BACKUP_BUCKET__",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "pairs/__APPROVED_RECOVERY_PAIR_ID__/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadOnlyApprovedRecoveryPair",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold"
      ],
      "Resource": "arn:aws:s3:::__BACKUP_BUCKET__/pairs/__APPROVED_RECOVERY_PAIR_ID__/*"
    },
    {
      "Sid": "DecryptApprovedPairEnvelopeKeys",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:__REGION__:__BACKUP_ACCOUNT_ID__:key/__ENCRYPTION_KEY_ID__",
      "Condition": {
        "StringEquals": {
          "kms:EncryptionContext:carbonlite-purpose": "backup-pair",
          "kms:EncryptionContext:recovery-pair-id": "__APPROVED_RECOVERY_PAIR_ID__"
        }
      }
    },
    {
      "Sid": "SubmitRecoveryRequestsOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::__CONTROL_BUCKET__/recovery/requests/*"
    },
    {
      "Sid": "ReadRecoveryStateAndEvidence",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::__CONTROL_BUCKET__",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "events/*",
            "recovery/*",
            "checkpoints/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadRecoveryStateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::__CONTROL_BUCKET__/events/*",
        "arn:aws:s3:::__CONTROL_BUCKET__/recovery/*",
        "arn:aws:s3:::__CONTROL_BUCKET__/checkpoints/*"
      ]
    }
  ]
}
